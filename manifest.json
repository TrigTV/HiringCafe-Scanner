{
  "manifest_version": 3,
  "name": "HiringCafe Resume Scanner",
  "version": "1.0.0",
  "description": "Match job listings to your resume with color-coded compatibility highlights. Resume never leaves your device.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://hiring.cafe/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HiringCafe Resume Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://hiring.cafe/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
